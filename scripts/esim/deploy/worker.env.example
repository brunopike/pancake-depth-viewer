# Install as /etc/esim-worker/worker.env, root:root, mode 0600.
# No wallet credentials are required. Use a fine-grained GitHub token restricted
# to this one repository (Contents read/write), never a broad personal token.
ESIM_REALTIME_DATABASE_URL=
ALCHEMY_API_KEY=
GITHUB_TOKEN=
GITHUB_REPOSITORY=brunopike/pancake-depth-viewer
ESIM_WORKER_DRY_RUN=true

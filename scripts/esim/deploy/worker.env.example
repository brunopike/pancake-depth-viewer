# Install as /etc/esim-worker/worker.env, root:root, mode 0600.
# No wallet credentials are required. The VM uses a repository-only SSH deploy
# key; no personal GitHub token is copied. Actions retains its temporary token.
ESIM_REALTIME_DATABASE_URL=
ALCHEMY_API_KEY=
GITHUB_REPOSITORY=brunopike/pancake-depth-viewer
ESIM_GIT_PUBLISH=true
ESIM_WORKER_DRY_RUN=true

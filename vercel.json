{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/esim.js": {
      "maxDuration": 300,
      "includeFiles": "server/esim/**"
    },
    "api/holders.js": {
      "maxDuration": 60,
      "includeFiles": "server/esim/**"
    },
    "api/alchemy-webhook.js": {
      "maxDuration": 30
    },
    "api/esim-snapshot.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/data/current-esim-claim-flow.json.gz",
      "destination": "https://raw.githubusercontent.com/brunopike/pancake-depth-viewer/esim-cache/claim-flow.json.gz"
    },
    {
      "source": "/data/current-depth/:filename",
      "destination": "https://raw.githubusercontent.com/brunopike/pancake-depth-viewer/depth-cache/:filename"
    },
    {
      "source": "/data/current-esim-claim-flow.json",
      "destination": "https://raw.githubusercontent.com/brunopike/pancake-depth-viewer/esim-cache/claim-flow.json"
    },
    {
      "source": "/data/current-esim-report.json",
      "destination": "https://raw.githubusercontent.com/brunopike/pancake-depth-viewer/esim-cache/report.json"
    },
    {
      "source": "/data/current-esim-addresses.json",
      "destination": "https://raw.githubusercontent.com/brunopike/pancake-depth-viewer/esim-cache/addresses.json"
    },
    {
      "source": "/data/current-esim-holders.json",
      "destination": "https://raw.githubusercontent.com/brunopike/pancake-depth-viewer/holder-cache/holders.json"
    },
    {
      "source": "/data/current-esim-cohort.json.gz",
      "destination": "https://raw.githubusercontent.com/brunopike/pancake-depth-viewer/esim-cache/cohort.json.gz"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "report"
        }
      ],
      "destination": "/esim.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "addresses"
        }
      ],
      "destination": "/esim-addresses.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "holders"
        }
      ],
      "destination": "/esim-holders.html",
      "permanent": false
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "has": [{ "type": "query", "key": "view", "value": "report" }], "destination": "/esim.html" },
    { "source": "/", "has": [{ "type": "query", "key": "view", "value": "addresses" }], "destination": "/esim-addresses.html" },
    { "source": "/", "has": [{ "type": "query", "key": "view", "value": "holders" }], "destination": "/esim-holders.html" }
  ],
  "functions": {
    "api/esim.js": {
      "maxDuration": 300,
      "includeFiles": "server/esim/**"
    },
    "api/holders.js": {
      "maxDuration": 60,
      "includeFiles": "server/esim/**"
    }
  }
}
